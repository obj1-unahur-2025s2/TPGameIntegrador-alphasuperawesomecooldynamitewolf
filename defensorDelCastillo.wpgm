import castillo.*
import wollok.game.*
import juegoBase.*
import niveles.*

program DefensorDelCastillo {
	//movimientos jugador  //meter limitaciones y q no salga del mapa , y solo ubicar en  donde se pueda situar 
	keyboard.left().onPressDo({personajePrincipal.moverseHaciaIzquierda()})
	keyboard.right().onPressDo({personajePrincipal.moverseHaciaDerecha()})
	keyboard.up().onPressDo({personajePrincipal.moverseHaciaArriba()})
	keyboard.down().onPressDo({personajePrincipal.moverseHaciaAbajo()})

	juegoDelCastillo.iniciar()
	torresOpciones.iniciar()
	//teclas de opciones torres 
	keyboard.z().onPressDo({personajePrincipal.agregarTorre(torresOpciones.obtenerTorreNormal())}) //Z para poner la torre normal 
	keyboard.x().onPressDo({personajePrincipal.agregarTorre(torresOpciones.obtenerTorreCañon())}) //X para la torre de cañon
	//teclas opciones

	keyboard.w().onPressDo({cursorMenu.moverseHaciaArriba()})
	keyboard.s().onPressDo({cursorMenu.moverseHaciaAbajo()})
	game.start()
}
